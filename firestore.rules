rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidForm(data) {
      return data.id is string && data.id.size() <= 128
          && data.title is string && data.title.size() <= 300
          && data.description is string && data.description.size() <= 10000
          && data.createdAt is string && data.createdAt.size() <= 128
          && data.questions is list && data.questions.size() <= 200;
    }

    match /forms/{formId} {
      // Allow fetching individual forms by valid ID
      allow get: if isValidId(formId);
      
      // Stop list queries directly from direct clients
      allow list: if false;

      // Allow writes with validation
      allow create: if isValidId(formId) && isValidForm(request.resource.data);
      allow update: if isValidId(formId) && isValidForm(request.resource.data);
      allow delete: if isValidId(formId);
    }
  }
}
